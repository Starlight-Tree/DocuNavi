{
  "name": "docunavi-data-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "test": "node --test src/authConfig.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "deploy": "wrangler deploy",
    "build:node": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/node.mjs",
    "start:node": "node dist/node.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "better-auth": "1.7.18",
    "hono": "4.13.17",
    "kysely": "^0.29.8",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.10",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "wrangler": "4.158.0"
  }
}
