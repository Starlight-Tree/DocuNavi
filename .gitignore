node_modules/
.env
.venv/
# ops/django-saas（学習用の Django）専用の仮想環境
.venv-django/
__pycache__/
.pytest_cache/

# gcloud の短期トークン（scripts/issue-agent-token.sh が書き出す。コミットしない）
.gcloud-token*

# Claude Code の個人の許可設定（承認の操作で自動生成される。コミットしない。共有の設定は .claude/settings.json）
.claude/settings.local.json

# ベクトル検索の評価が作る、質問の埋め込みのキャッシュ（scripts/eval_vector.py。コミットしない）
/evals/cache/

# Playwright MCP が作る画面確認の成果物（スクリーンショット・スナップショット・コンソールログ。コミットしない）
.playwright-mcp/

# Playwright E2E（frontend/e2e）の成果物。コミットしない（E2E 用のビルド .next-e2e* は frontend/.gitignore）
test-results/
playwright-report/


# このマシン専用の Compose の重ね書き（ホストの絶対パスを含む）
.devcontainer/docker-compose.local.yml

# このマシン専用の Claude Code への指示（/tm の運用など）
CLAUDE.local.md

# GraphRAG評価の比較結果（生成物のため管理しない）
evals/results/graph_rules_compare.json
evals/results/graph_rules_ext_compare.json

# 生成物（evals/synth: テスト用の架空資料。本番の検索に混ぜない。コミットしない）
/evals/synth/out/
/evals/synth/fonts/

# DB のダンプ（個人情報を含む。暗号化した場所へ移す。コミットしない）
/backups/
