node_modules/
.env
# psql の接続情報（パスワードを含む）。置き場所は ~/.pgpass でリポジトリの外だが、誤ってコピーしてもコミットしない
.pgpass
.venv/
# ops/django-saas（学習用の Django）専用の仮想環境
.venv-django/
__pycache__/
.pytest_cache/

# gcloud の短期トークン（scripts/issue-agent-token.sh が書き出す。コミットしない）
.gcloud-token*

# Claude Code の個人の許可設定（承認の操作で自動生成される。コミットしない。共有の設定は .claude/settings.json）
.claude/settings.local.json

# ベクトル検索の評価が作る、質問の埋め込みのキャッシュ（scripts/eval_vector.py。コミットしない）
/evals/cache/

# Playwright MCP が作る画面確認の成果物（スクリーンショット・スナップショット・コンソールログ。コミットしない）
.playwright-mcp/

# Playwright E2E（frontend-next/e2e）の成果物。コミットしない（E2E 用のビルド .next-e2e* は frontend-next/.gitignore）
test-results/
playwright-report/

# ops/access_admin（管理画面）の collectstatic の出力
/ops/access_admin/staticfiles/
