# コピーして .env.local にすると有効になります（.env.local は Git に含まれません）。

# 開発サーバー（npm run dev）が /chat と /health を転送する先。既定は http://localhost:8000
VITE_DEV_PROXY_TARGET=http://localhost:8000

# API のベース URL。空のまま（相対 URL = 同一オリジン）が既定で、本番もこの設定のまま動きます。
# 別オリジンの API を直接呼ぶ場合だけ設定します（バックエンド側の CORS_ORIGINS の設定も必要）。
VITE_API_BASE_URL=
