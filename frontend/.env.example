# コピーして .env.local にすると有効になります（.env.local は Git に含まれません）。
# NEXT_PUBLIC_* は、ビルドでバンドルに埋め込まれ、誰でも読めます。入れてよいのは公開してよい値だけです。

# API のベース URL。別オリジンの API（Cloud Run）を、ブラウザーが直接呼ぶときに設定します（バックエンドの CORS_ORIGINS も必要）。
# 空のままなら相対 URL（同じオリジン）で呼びます。その場合は、下の API_PROXY_TARGET で、開発サーバーが API へ転送します。
NEXT_PUBLIC_API_BASE_URL=

# /chat/stream だけの接続先（Go の SSE 中継。ops/sse-relay/）。空なら NEXT_PUBLIC_API_BASE_URL を使います（中継を通さない）。
# ほかのエンドポイント（/threads /documents /health など）は、この値に関わらず NEXT_PUBLIC_API_BASE_URL のままです。
NEXT_PUBLIC_STREAM_BASE_URL=

# 開発サーバー（npm run dev）が /chat /chat/stream /health /documents /threads を転送する先（next.config.ts の rewrites）。
# NEXT_PUBLIC_API_BASE_URL を空にするときに使います。ビルド時に決まります。
API_PROXY_TARGET=http://localhost:8000

# Google ログイン（Better Auth。データ用 Worker の /api/auth/*）。1 か true のときだけ、ログイン画面が出ます。
# 認証の API は、この画面と同じオリジンから呼びます（next.config.ts の rewrites が AUTH_PROXY_TARGET へ中継）。
NEXT_PUBLIC_AUTH_ENABLED=
# 認証の API の URL（空なら、この画面と同じオリジン。テスト用）
NEXT_PUBLIC_AUTH_BASE_URL=
# 開発サーバーが /api/auth/* を転送する先（データ用 Worker の URL。例: http://127.0.0.1:8787）
AUTH_PROXY_TARGET=
