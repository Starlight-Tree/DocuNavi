{
  "name": "docunavi-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:e2e": "NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_AUTH_ENABLED= NEXT_PUBLIC_AUTH_BASE_URL= NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100 NEXT_TELEMETRY_DISABLED=1 next build",
    "build:e2e:auth": "NEXT_DIST_DIR=.next-e2e-auth NEXT_PUBLIC_AUTH_ENABLED=1 NEXT_PUBLIC_AUTH_BASE_URL=https://auth.e2e.invalid NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100 NEXT_TELEMETRY_DISABLED=1 next build",
    "start:e2e": "NEXT_DIST_DIR=.next-e2e NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1 -p ${E2E_WEB_PORT:-3100}",
    "start:e2e:auth": "NEXT_DIST_DIR=.next-e2e-auth NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1 -p ${E2E_AUTH_WEB_PORT:-3101}",
    "test:e2e": "playwright test",
    "test:e2e:real-api": "E2E_REAL_API=1 playwright test",
    "build:cf": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.132",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.129",
    "better-auth": "1.7.18",
    "next": "^16.4.3",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "4.158.0"
  }
}
