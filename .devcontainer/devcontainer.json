// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Chatbot App",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/devcontainers/features/python:1": {}
		// gcloud は feature ではなく postCreateCommand（.devcontainer/install-gcloud.sh）で入れる。
		// コミュニティの google-cloud-cli feature は apt-key を使い、Debian 13（trixie）ではビルドが失敗するため
	},

	// コンテナを再ビルドしても Claude Code の履歴・認証情報が消えないよう、~/.claude を名前付きボリュームに永続化する
	"mounts": [
		"source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
	],

	// claude-volume: 新規作成直後のボリュームは root 所有になるため、vscode ユーザーが書き込めるようにする。
	// gcloud: 導入だけを行う（ログインは含まない。README の「開発環境の gcloud」）。失敗してもコンテナの作成は止まらない
	"postCreateCommand": {
		"claude-volume": "sudo chown -R vscode:vscode /home/vscode/.claude",
		"gcloud": "bash .devcontainer/install-gcloud.sh"
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// コンテナの作成・再ビルド時に自動でインストールする拡張機能。
	// Python 系は features/python も入れるが、設定ファイルの python.analysis.* を使うので明示しておく
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-azuretools.vscode-containers",
				"mhutchie.git-graph"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
