// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "DocuNavi",
	// 2026-10-22 から Compose ベース。開発コンテナ（dev）と、アプリの api・frontend を、同じ Compose のプロジェクト docunavi に置く。
	// 定義は ../docker-compose.yml（api・frontend。ホストの `docker compose up` と共通）と ./docker-compose.yml（dev。ここだけ）。
	// dev の定義（イメージのビルド、マウント、環境変数、ネットワーク、コンテナ名、init）は ./docker-compose.yml にある。
	// ここに mounts / containerEnv / runArgs / init を書かない（Compose では二重になる、または効かない）。
	// gcloud はイメージに入れる（.devcontainer/Dockerfile。MCP の headersHelper が起動の約 11 秒後に gcloud を使うため、
	// postCreateCommand では間に合わない）。ベースは同じ mcr.microsoft.com/devcontainers/base:trixie。
	"dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
	// service: VS Code が接続する先（開発コンテナ）。runServices: 一緒に起動するアプリ側のサービス（service は自動で含まれる）。
	// 実キーの .env でも D1_API_URL が無いと、api は起動の検査に失敗して unhealthy のまま止まる（ローカルの api は D1 につながない。モックモードなら起動する）。
	// それでも開発コンテナの作成が止まらないよう、./docker-compose.yml で frontend の待ちを service_started に緩めてある。
	"service": "dev",
	"runServices": ["api", "frontend"],
	"workspaceFolder": "/workspaces/docunavi",
	"remoteUser": "vscode",
	// stopCompose: VS Code のウィンドウを閉じると、dev・api・frontend をまとめて止める（down ではない。コンテナも残る）。
	"shutdownAction": "stopCompose",
	// Docker は、ホストのソケットを渡さず、読み取り専用のプロキシ（.devcontainer/docker-proxy/compose.yml）経由にする。
	// initializeCommand: ホストで、コンテナの作成の前に実行される。プロキシを起動し、ネットワーク docunavi-dev を作る
	// （無いと、./docker-compose.yml の external のネットワークが見つからず失敗する）。ホストに docker（OrbStack）が無いと、ここで止まる。
	"initializeCommand": "docker compose -f .devcontainer/docker-proxy/compose.yml up -d",

	"features": {
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/devcontainers/features/python:1": {}
		// gh は feature ではなく postCreateCommand（.devcontainer/install-gh.sh）で入れる。gcloud は上の Dockerfile。
		// コミュニティの google-cloud-cli feature は apt-key を使い、Debian 13（trixie）ではビルドが失敗し、
		// feature の失敗はコンテナの作成ごと止めるため
	},

	// 永続化するボリューム（~/.claude、gh、gcloud、Infisical、Playwright）は、mounts ではなく ./docker-compose.yml の dev に移した
	// （理由のコメントもそちら。ボリューム名は今のまま）。ここに mounts を書くと、同じ場所への二重のマウントでエラーになる。
	//
	// containerEnv は、ここに残す（CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT と DOCKER_HOST を含む。場所を変えない）。
	// Compose ベースで containerEnv が効くかは未確認なので、同じ値を ./docker-compose.yml の dev の environment にも置く。
	// 値を変えるときは両方を直す。
	// GH_CONFIG_DIR: ~/.config/gh ではなく専用の場所にする。~/.config がイメージに無いと、マウントの親ディレクトリが
	// root 所有で作られ、他のツールが ~/.config に書けなくなるため。gcloud は、ガードのフックと拒否ルールが
	// ~/.config/gcloud を守っているので、場所を変えずにマウントし、親の所有者は postCreateCommand の gcloud-volume で直す。
	// TZ: date やログの時刻を JST にする（開発コンテナだけ。Docker イメージや Cloud Run の時刻は変わらない）
	// CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT: gcloud の日常の ID を、閲覧専用の docunavi-viewer（運用用プロジェクト docunavi-ops のサービスアカウント）へのなりすましに
	// 固定する。ターミナルでもエージェントの実行でも、起動した時点から閲覧専用になる（手動で設定・解除しない）。
	// 書き込みは、コマンドごとに明示する（env -u でこの変数を外すか、--impersonate-service-account で別の SA を
	// 指定する）。手順は .devcontainer/README.md。
	// CLAUDE_CONFIG_DIR: Claude Code の設定ファイル（.claude.json。ローカル登録の MCP を含む）を ~/.claude のボリューム側
	// （~/.claude/.claude.json）に置き、再ビルドで消えないようにする。Mac の ~/.claude.json は使わない。
	"containerEnv": {
		"GH_CONFIG_DIR": "/home/vscode/.gh-config",
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"TZ": "Asia/Tokyo",
		"DOCKER_HOST": "tcp://docunavi-docker-proxy:2375",
		"CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT": "docunavi-viewer@docunavi-ops.iam.gserviceaccount.com",
		"INFISICAL_DISABLE_TELEMETRY": "true",
		"INFISICAL_DISABLE_UPDATE_CHECK": "true"
	},

	// claude-volume / gh-volume: 新規作成直後のボリュームは root 所有になるため、vscode ユーザーが書き込めるようにする。
	// infisical-volume: ~/.infisical（Infisical CLI の状態とマシンアイデンティティの資格情報のボリューム）も同じ。権限は 700（資格情報のファイルは 600 でユーザーが置く）。
	// INFISICAL_DISABLE_*: Infisical CLI のテレメトリーと更新確認を止める（同じ値を ./docker-compose.yml の environment にも置く）。
	// gcloud・gh・Go・Infisical CLI・docker-cli・Playwright のライブラリーは、イメージ（.devcontainer/Dockerfile）に入れてある。ここでは入れない。
	// cli-tools: 次を順番に実行する（ログインや接続情報は含まない）。失敗してもコンテナの作成は止まらない（最後のコマンドの終了コードが 0 のため）。
	//   1. install-playwright.sh: Playwright MCP（user スコープの登録）用の Chromium（~/.cache/ms-playwright のボリュームに入る。所有者の修正もこのスクリプトが行う）の取得と、
	//      起動確認（--version。ライブラリーの取りこぼしもここで分かる）。README の「開発環境のブラウザー確認」
	//   2. ツールの存在確認: イメージに入れたツールが PATH にあるかを見て、無ければ「missing: 名前」を標準エラーに出す（導入はしない）。
	// Vercel CLI は入れない（2026-10-31 に削除。必要なときは npx --yes vercel@63.1.2 を使う。README の「開発環境の Vercel（廃止）」）。
	// 並列に動く別エントリにはしない（並列化は、この移設の効果を測ってから検討する）。
	"postCreateCommand": {
		"claude-volume": "sudo chown -R vscode:vscode /home/vscode/.claude",
		"gh-volume": "sudo chown -R vscode:vscode /home/vscode/.gh-config",
		"infisical-volume": "sudo chown -R vscode:vscode /home/vscode/.infisical && chmod 700 /home/vscode/.infisical",
		"gcloud-volume": "sudo chown vscode:vscode /home/vscode/.config && sudo chown -R vscode:vscode /home/vscode/.config/gcloud && chmod 700 /home/vscode/.config/gcloud",
		"project-manager-volume": "sudo chown -R vscode:vscode /home/vscode/.project-manager",
		"cli-tools": "bash .devcontainer/install-playwright.sh; for t in gcloud gh go docker infisical; do command -v $t >/dev/null || echo missing: $t >&2; done"
	},

	"postStartCommand": "bash .devcontainer/persist-infisical-login.sh > /tmp/persist-infisical-login.log 2>&1 || true; REGISTER_INFISICAL_MCP_WAIT_TRIES=4 bash .devcontainer/register-infisical-mcp.sh > /tmp/register-infisical-mcp.log 2>&1 || true",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// 3100: frontend/ の next dev、8100: tests/e2e_server.py の偽 API（Next.js 版の画面をホストのブラウザーで確かめる用）
	"forwardPorts": [3100, 8100],

	// コンテナの作成・再ビルド時に自動でインストールする拡張機能。
	// Python 系は features/python も入れるが、設定ファイルの python.analysis.* を使うので明示しておく
	// settings: Container Tools の一覧の見出しを、イメージ名（既定の FullTag。開発コンテナは vsc-docunavi-<ハッシュ>）ではなく
	// コンテナ名にする。右側の説明は、見出しと重なるコンテナ名をやめて状態だけにする。キーは拡張 2.5.3 の package.json で確認。
	"customizations": {
		"vscode": {
			"settings": {
				"containers.containers.label": "ContainerName",
				"containers.containers.description": ["Status"],
				// VS Code の AI 機能（GitHub Copilot のチャットなど）を、この開発コンテナでは無効にする（ユーザーが決定、2026-11-02）。Claude Code の拡張は別物
				"chat.disableAIFeatures": true
			},
			"extensions": [
				"anthropic.claude-code",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"mhutchie.git-graph",
				"ms-ossdata.vscode-pgsql",
				"ms-azuretools.vscode-containers",
				"golang.go",
				"alefragnani.project-manager"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
