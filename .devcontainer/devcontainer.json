// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "DocuNavi",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// gcloud はイメージに入れる（.devcontainer/Dockerfile。MCP の headersHelper が起動の約 11 秒後に gcloud を使うため、
	// postCreateCommand では間に合わない）。ベースは同じ mcr.microsoft.com/devcontainers/base:trixie。
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Docker は、ホストのソケットを渡さず、読み取り専用のプロキシ（.devcontainer/docker-proxy/compose.yml）経由にする。
	// initializeCommand: ホストで、コンテナの作成の前に実行される。プロキシを起動し、ネットワーク docunavi-dev を作る
	// （無いと runArgs の --network が失敗する）。ホストに docker（OrbStack）が無いと、ここで止まる。
	// runArgs: 開発コンテナを docunavi-dev に繋ぐ。DOCKER_HOST（下の containerEnv）はこのネットワークの中でだけ引ける名前。
	// init: プロセスの後始末（ゾンビの回収）を init に任せる。
	"initializeCommand": "docker compose -f .devcontainer/docker-proxy/compose.yml up -d",
	"runArgs": ["--network=docunavi-dev"],
	"init": true,

	"features": {
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/devcontainers/features/python:1": {}
		// gh は feature ではなく postCreateCommand（.devcontainer/install-gh.sh）で入れる。gcloud は上の Dockerfile。
		// コミュニティの google-cloud-cli feature は apt-key を使い、Debian 13（trixie）ではビルドが失敗し、
		// feature の失敗はコンテナの作成ごと止めるため
	},

	// コンテナを再ビルドしても Claude Code の履歴・認証情報が消えないよう、~/.claude を名前付きボリュームに永続化する。
	// gh の設定（トークンを含む）も、読み取り専用の細粒度トークンだけを置く前提で、同じく永続化する
	// （README の「開発環境の GitHub CLI（gh）」）。
	// gcloud のログイン情報（~/.config/gcloud。リフレッシュトークンを含む）も、2026-10-21 から同じく名前付きボリュームに残す。
	// 再ビルドのたびに手動でログインし直さずに、MCP の headersHelper（scripts/mcp-auth-header.sh）がつながるようにするため。
	// それ以前は「残さない」設計だった（2026-10-13 のコメント。ユーザーの明示の決定だったかは確認できていない）。
	// 長期の資格情報が保存されるリスクを受け入れた変更。失効や組織のポリシー等で、再ログインが要ることはある。
	// 消し方は .devcontainer/README.md の「ログアウト」。
	// ~/.pg は psql の接続情報（pgpass。本番 DB を読み取り専用の readonly ロールで見る。docs/infra-readonly-role.sql）。
	// ホストの ~/.pgpass はマウントしない（ほかの DB の認証情報まで、コンテナーから読めてしまうため）。パスワードを入れるのはユーザー自身。
	"mounts": [
		"source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
		"source=gh-config-${devcontainerId},target=/home/vscode/.gh-config,type=volume",
		"source=gcloud-config-${devcontainerId},target=/home/vscode/.config/gcloud,type=volume",
		"source=pg-config-${devcontainerId},target=/home/vscode/.pg,type=volume",
		"source=playwright-browsers-${devcontainerId},target=/home/vscode/.cache/ms-playwright,type=volume"
	],

	// GH_CONFIG_DIR: ~/.config/gh ではなく専用の場所にする。~/.config がイメージに無いと、マウントの親ディレクトリが
	// root 所有で作られ、他のツールが ~/.config に書けなくなるため。gcloud は、ガードのフックと拒否ルールが
	// ~/.config/gcloud を守っているので、場所を変えずにマウントし、親の所有者は postCreateCommand の gcloud-volume で直す。
	// TZ: date やログの時刻を JST にする（開発コンテナだけ。Docker イメージや Cloud Run の時刻は変わらない）
	// CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT: gcloud の日常の ID を、閲覧専用の docunavi-viewer（運用用プロジェクト docunavi-ops のサービスアカウント）へのなりすましに
	// 固定する。ターミナルでもエージェントの実行でも、起動した時点から閲覧専用になる（手動で設定・解除しない）。
	// 書き込みは、コマンドごとに明示する（env -u でこの変数を外すか、--impersonate-service-account で別の SA を
	// 指定する）。手順は .devcontainer/README.md。
	// CLAUDE_CONFIG_DIR: Claude Code の設定ファイル（.claude.json。ローカル登録の MCP を含む）を ~/.claude のボリューム側
	// （~/.claude/.claude.json）に置き、再ビルドで消えないようにする。Mac の ~/.claude.json は使わない。
	"containerEnv": {
		"GH_CONFIG_DIR": "/home/vscode/.gh-config",
		"PGPASSFILE": "/home/vscode/.pg/pgpass",
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"TZ": "Asia/Tokyo",
		"DOCKER_HOST": "tcp://docunavi-docker-proxy:2375",
		"CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT": "docunavi-viewer@docunavi-ops.iam.gserviceaccount.com"
	},

	// claude-volume / gh-volume: 新規作成直後のボリュームは root 所有になるため、vscode ユーザーが書き込めるようにする。
	// cli-tools: gh・Playwright・psql の導入だけを行う（ログインや接続情報は含まない。gcloud は Dockerfile）。失敗してもコンテナの作成は止まらない。
	// 並列に動く別エントリにすると apt のロックを取り合うので、順番に実行する。
	// install-playwright.sh: Playwright MCP（.mcp.json）用の Chromium（~/.cache/ms-playwright のボリュームに入る。
	// 所有者の修正もこのスクリプトが行う）と、Chromium に要るライブラリーの導入。README の「開発環境のブラウザー確認」
	"postCreateCommand": {
		"claude-volume": "sudo chown -R vscode:vscode /home/vscode/.claude",
		"gh-volume": "sudo chown -R vscode:vscode /home/vscode/.gh-config",
		"pg-volume": "sudo chown -R vscode:vscode /home/vscode/.pg && chmod 700 /home/vscode/.pg",
		"gcloud-volume": "sudo chown vscode:vscode /home/vscode/.config && sudo chown -R vscode:vscode /home/vscode/.config/gcloud && chmod 700 /home/vscode/.config/gcloud",
		"cli-tools": "bash .devcontainer/install-gh.sh; bash .devcontainer/install-playwright.sh; bash .devcontainer/install-psql.sh"
	},

	// 起動のたびに、書き込み可能な Supabase MCP（supabase-write。ローカル登録）を今の作業ディレクトリに登録し直す。
	// ローカル登録は作業ディレクトリのパスがキーなので、フォルダー名を変えると、ボリュームに設定が残っていても外れるため。
	// 登録だけで、認証や DB の呼び出しはしない。何度実行しても同じ（登録済みなら何もしない）。
	// 前景で実行する。バックグラウンドの子プロセスは、起動処理の終了で止められる（`( … &)` も `setsid nohup … &` も、
	// 2026-10-20 の再ビルドでログができなかった）。登録は 1〜2 秒で終わる。
	// REGISTER_SUPABASE_WAIT_TRIES=4: claude の実体（VS Code の拡張）が無いときの待ちを最大 20 秒にする（5 秒 × 4 回）。
	// 失敗や見つからないときも、終了コード 0 でコンテナは起動する（`|| true`）。結果は /tmp/register-supabase-write.log
	// （成功・登録済み・失敗のどれかが残る）。
	"postStartCommand": "REGISTER_SUPABASE_WAIT_TRIES=4 bash .devcontainer/register-supabase-write.sh > /tmp/register-supabase-write.log 2>&1 || true",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// コンテナの作成・再ビルド時に自動でインストールする拡張機能。
	// Python 系は features/python も入れるが、設定ファイルの python.analysis.* を使うので明示しておく
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"mhutchie.git-graph",
				"ms-ossdata.vscode-pgsql",
				"ms-azuretools.vscode-containers"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
