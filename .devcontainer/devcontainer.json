// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Chatbot App",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/devcontainers/features/python:1": {}
		// gcloud と gh は feature ではなく postCreateCommand（.devcontainer/install-*.sh）で入れる。
		// コミュニティの google-cloud-cli feature は apt-key を使い、Debian 13（trixie）ではビルドが失敗し、
		// feature の失敗はコンテナの作成ごと止めるため
	},

	// コンテナを再ビルドしても Claude Code の履歴・認証情報が消えないよう、~/.claude を名前付きボリュームに永続化する。
	// gh の設定（トークンを含む）も、読み取り専用の細粒度トークンだけを置く前提で、同じく永続化する
	// （README の「開発環境の GitHub CLI（gh）」）。gcloud のログインは残さない。
	"mounts": [
		"source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
		"source=gh-config-${devcontainerId},target=/home/vscode/.gh-config,type=volume",
		"source=playwright-browsers-${devcontainerId},target=/home/vscode/.cache/ms-playwright,type=volume"
	],

	// GH_CONFIG_DIR: ~/.config/gh ではなく専用の場所にする。~/.config がイメージに無いと、マウントの親ディレクトリが
	// root 所有で作られ、他のツール（gcloud など）が ~/.config に書けなくなるため。
	// TZ: date やログの時刻を JST にする（開発コンテナだけ。Docker イメージや Cloud Run の時刻は変わらない）
	// CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT: gcloud の日常の ID を、閲覧専用の agent-viewer へのなりすましに
	// 固定する。ターミナルでもエージェントの実行でも、起動した時点から閲覧専用になる（手動で設定・解除しない）。
	// 書き込みは、コマンドごとに明示する（env -u でこの変数を外すか、--impersonate-service-account で別の SA を
	// 指定する）。手順は .devcontainer/README.md。
	"containerEnv": {
		"GH_CONFIG_DIR": "/home/vscode/.gh-config",
		"TZ": "Asia/Tokyo",
		"CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT": "agent-viewer@wataru-sandbox.iam.gserviceaccount.com"
	},

	// claude-volume / gh-volume: 新規作成直後のボリュームは root 所有になるため、vscode ユーザーが書き込めるようにする。
	// cli-tools: gcloud・gh・Playwright の導入だけを行う（ログインは含まない）。失敗してもコンテナの作成は止まらない。
	// 並列に動く別エントリにすると apt のロックを取り合うので、順番に実行する。
	// install-playwright.sh: Playwright MCP（.mcp.json）用の Chromium（~/.cache/ms-playwright のボリュームに入る。
	// 所有者の修正もこのスクリプトが行う）と、Chromium に要るライブラリーの導入。README の「開発環境のブラウザー確認」
	"postCreateCommand": {
		"claude-volume": "sudo chown -R vscode:vscode /home/vscode/.claude",
		"gh-volume": "sudo chown -R vscode:vscode /home/vscode/.gh-config",
		"cli-tools": "bash .devcontainer/install-gcloud.sh; bash .devcontainer/install-gh.sh; bash .devcontainer/install-playwright.sh"
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// コンテナの作成・再ビルド時に自動でインストールする拡張機能。
	// Python 系は features/python も入れるが、設定ファイルの python.analysis.* を使うので明示しておく
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-azuretools.vscode-containers",
				"mhutchie.git-graph"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
