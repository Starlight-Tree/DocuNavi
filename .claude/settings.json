{
  "outputStyle": "Concise",
  "env": {
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gcloud --version)",
      "Bash(gcloud version)",
      "Bash(gcloud auth list *)",
      "Bash(gcloud config list *)",
      "Bash(gcloud projects list *)",
      "Bash(gcloud builds list *)",
      "Bash(gcloud builds describe *)",
      "Bash(gcloud builds triggers list *)",
      "Bash(gcloud builds triggers describe *)",
      "Bash(gcloud run services list *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud run revisions list *)",
      "Bash(gcloud run revisions describe *)",
      "Bash(gcloud logging read *)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)",
      "Bash(gh ruleset list *)",
      "Bash(gh ruleset view *)",
      "Bash(gh ruleset check *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(docker ps *)",
      "Bash(scripts/dlogs.sh *)"
    ],
    "deny": [
      "Read(~/.config/gcloud/**)",
      "Read(./.gcloud-token*)",
      "Read(~/.config/gh/**)",
      "Read(~/.gh-config/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./frontend/.env.local)",
      "Read(./workers/api/.dev.vars)",
      "Read(~/.infisical/**)",
      "Read(~/.ssh/**)",
      "Bash(docker inspect *)",
      "Bash(docker exec *)",
      "Bash(docker run *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker system *)",
      "Bash(docker compose config *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose restart *)",
      "Bash(git commit *--no-verify*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(scripts/mcp-proxy.sh)",
      "mcp__cloudflare__execute",
      "mcp__github__actions_run_trigger",
      "mcp__playwright__browser_run_code_unsafe"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-cloud-cli.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-foreground-wait.py"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-write.py"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-deploy-cli.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_run_code_unsafe",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-log.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__playwright__browser_run_code_unsafe|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-log.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "mcp__playwright__browser_run_code_unsafe|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-log.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__playwright__browser_run_code_unsafe",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-log.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__playwright__browser_run_code_unsafe",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-log.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-rules.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
