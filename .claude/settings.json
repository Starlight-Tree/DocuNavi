{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(gcloud --version)",
      "Bash(gcloud version)",
      "Bash(gcloud auth list *)",
      "Bash(gcloud config list *)",
      "Bash(gcloud projects list *)",
      "Bash(gcloud builds list *)",
      "Bash(gcloud builds describe *)",
      "Bash(gcloud builds triggers list *)",
      "Bash(gcloud builds triggers describe *)",
      "Bash(gcloud run services list *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud run revisions list *)",
      "Bash(gcloud run revisions describe *)",
      "Bash(gcloud logging read *)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)",
      "Bash(gh ruleset list *)",
      "Bash(gh ruleset view *)",
      "Bash(gh ruleset check *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "mcp__cloudflare__execute"
    ],
    "deny": [
      "Read(~/.config/gcloud/**)",
      "Read(./.gcloud-token*)",
      "Read(~/.config/gh/**)",
      "Read(~/.gh-config/**)",
      "Read(./.env)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-cloud-cli.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "supabase-write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/accept-supabase-elicitation.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
