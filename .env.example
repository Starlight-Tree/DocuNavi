# --- LLM の認証（どちらか一方） ---
# A) Gemini API キー: https://aistudio.google.com/apikey で取得
#    未設定（空 / このテンプレートのまま）の場合は「モックモード」で動作し、
#    資料を検索せず、固定のダミーの返答を返します（画面と API の動作確認用）。
GEMINI_API_KEY=your_api_key_here

# B) Vertex AI（Cloud Run など。キー不要で、ADC / サービスアカウントで認証）
#    true にすると GEMINI_API_KEY の有無にかかわらず本物の LLM を使います。
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global

# モデル名（省略時は gemini-3.1-flash-lite）
# GEMINI_MODEL=gemini-3.1-flash-lite

# 主モデルが一時的な失敗を続けたときだけ、このモデルで 1 回試します（省略時は使いません）。
# 料金と品質が変わります。主モデルで始めた会話を別モデルで続けられるかは未検証です。
# 有効にする前に docs/configuration.md の「主モデルが落ちたとき（フォールバック）」を読んでください。
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# フォールバックに切り替えたあと、何秒間、主モデルを飛ばすか（既定 60。0 で無効）
# GEMINI_FALLBACK_HOLD_SECONDS=60

# Postgres の接続 URL。本物の LLM（GEMINI_API_KEY あり）では必須です（資料の検索が DB のベクトル検索を読むため。docs/search-design.md）。
# 会話履歴の保存先も兼ねます。モックモードで空なら、履歴はプロセス内メモリで、再起動すると消えます。
# 値は秘密情報（パスワードを含む）です。コミットしません。詳細は docs/configuration.md
# 例: postgresql://user:password@host:5432/postgres
# Supabase のプーラー（transaction mode）では、ポートは 6543、ユーザー名は「ロール名.プロジェクトID」です。
# 例: postgresql://role.project_id:password@pooler_host:6543/postgres
DATABASE_URL=
# DATABASE_POOL_MAX_SIZE=5

# CORS で許可するオリジン（カンマ区切り。省略時は * ）
CORS_ORIGINS=http://localhost:3000

# ログイン（Supabase Auth の JWT 検証）。off（既定）は匿名のまま。公開するときは required にします。
# required では SUPABASE_URL が必須で、JWKS の公開鍵を取得できないと起動に失敗します。docs/configuration.md の「ログイン（認証）」
# AUTH_MODE=off
# SUPABASE_URL=https://<project-ref>.supabase.co
