# --- LLM の認証（どちらか一方） ---
# A) Gemini API キー: https://aistudio.google.com/apikey で取得
#    未設定（空 / このテンプレートのまま）の場合は「モックモード」で動作し、
#    storage/chunk/ の設定資料から抜粋したダミーの返答を返します。
GEMINI_API_KEY=your_api_key_here

# B) Vertex AI（Cloud Run など。キー不要で、ADC / サービスアカウントで認証）
#    true にすると GEMINI_API_KEY の有無にかかわらず本物の LLM を使います。
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global

# モデル名（省略時は gemini-3.1-flash-lite）
# GEMINI_MODEL=gemini-3.1-flash-lite

# CORS で許可するオリジン（カンマ区切り。省略時は * ）
CORS_ORIGINS=http://localhost:3000
