# --- LLM の認証（どちらか一方） ---
# A) Gemini API キー: https://aistudio.google.com/apikey で取得
#    未設定（空 / このテンプレートのまま）の場合は「モックモード」で動作し、
#    資料を検索せず、固定のダミーの返答を返します（画面と API の動作確認用）。
GEMINI_API_KEY=your_api_key_here

# B) Vertex AI（Cloud Run など。キー不要で、ADC / サービスアカウントで認証）
#    true にすると GEMINI_API_KEY の有無にかかわらず本物の LLM を使います。
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global

# モデル名（省略時は gemini-3.1-flash-lite）
# GEMINI_MODEL=gemini-3.1-flash-lite

# 主モデルが一時的な失敗を続けたときだけ、このモデルで 1 回試します（省略時は使いません）。
# 料金と品質が変わります。有効にする前に、docs/configuration.md の「主モデルが落ちたとき（フォールバック）」と、
# その「検証の状況」（確かめた範囲と、未確認の点）を読んでください。
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# フォールバックに切り替えたあと、何秒間、主モデルを飛ばすか（既定 60。0 で無効）
# GEMINI_FALLBACK_HOLD_SECONDS=60

# Postgres の接続 URL。本物の LLM（GEMINI_API_KEY あり）では必須です（docs/search-design.md）。会話履歴の保存先も兼ねます。
# モックモードで空なら、履歴はプロセス内メモリで、再起動すると消えます。
# 値は秘密情報（パスワードを含む）です。コミットしません。
# 例: postgresql://user:password@host:5432/postgres
DATABASE_URL=
# 1 プロセスの接続プールの上限（1 以上の整数。省略時は 3）。Cloud Run では、最大インスタンス数 × この値が DB の接続上限に収まるようにします。
# DATABASE_POOL_MAX_SIZE=3

# CORS で許可するオリジン（カンマ区切り。省略時は * ）
CORS_ORIGINS=http://localhost:3000

# ログイン（Better Auth が発行した JWT の検証）。off（既定）は匿名のまま。公開するときは required にします。
# required では AUTH_BASE_URL（Better Auth のオリジン。画面の Worker のオリジンで、/api/auth/* はデータ用 Worker へ中継される）が必須で、
# {AUTH_BASE_URL}/api/auth/jwks の公開鍵を取得できないと起動に失敗します。AUTH_AUDIENCE の既定は docunavi。docs/configuration.md の「ログイン（認証）」
# AUTH_MODE=off
# AUTH_BASE_URL=https://<画面の Worker のホスト>

# 利用者のロールごとに、見える資料グループ（documents.collection）を制限する。off（既定）は制限なし。
# shadow は制限せず、絞り込まれる件数をログに出す。enforce は実際に制限する（DATABASE_URL と、マイグレーション 20261026045921 が要る）。
# docs/configuration.md の「資料グループのアクセス制御」
# ACCESS_MODE=off

# LangSmith Studio（ローカル開発専用。本番の Cloud Run には渡さない）。`langgraph dev` で会話・グラフ・state・トレースを見る。
# 秘密は .env に置かず、Infisical に登録して `infisical sm run --env=dev -- …` で渡す（docs/development.md の「LangSmith Studio」）。
# Infisical に置くキー名（値はここに書かない）:
#   LANGSMITH_API_KEY / LANGSMITH_AGENT_ID / LANGSMITH_AGENT_ENVIRONMENT / LANGSMITH_ENDPOINT
# .env に置いてよいのは、公開してよい次の 1 行だけ。true だと、質問・検索結果の抜粋・回答が LangSmith（外部）へ送られる。
LANGSMITH_TRACING=true
